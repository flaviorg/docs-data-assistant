# Provedor: fake (padrão) | openrouter. Sem LLM_PROVIDER, usa openrouter se houver chave, senão fake.
LLM_PROVIDER=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash
GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
LLM_STRUCTURED_MODE=json_schema        # json_schema | json_object
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2                      # tentativas extras no mesmo modelo
LLM_MAX_CALLS_PER_REQUEST=8            # execuções lógicas de prompt (o máximo legítimo é 7)
LLM_TEMPERATURE=0.2
LLM_FAKE_CHAOS=none                    # none | primary-timeout-once | primary-down | all-down

EMBEDDER=hash                          # hash (único no v1; minilm chega no marco opcional M9)
RAG_TOP_K=3
RAG_MIN_SCORE=                         # vazio: usa o padrão calibrado do embedder
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

SQL_MAX_CORRECTIONS=3
SQL_MAX_ROWS=200
SQL_ROWS_TO_LLM=50
SQL_TIMEOUT_MS=5000                    # prazo de execução da SQL; passou, o processo filho leva SIGKILL

GUARDRAIL_MODE=                        # rules | rules+model | off. Vazio: rules no fake, rules+model no openrouter

APP_DB_PATH=data/app.db
SALES_DB_PATH=data/sales.db
HOST=127.0.0.1
PORT=3000
ASK_TIMEOUT_MS=60000
LOG_LEVEL=info
