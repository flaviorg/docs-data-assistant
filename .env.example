# Provider: fake (default) | openrouter. Without LLM_PROVIDER, uses openrouter if there is a key, otherwise fake.
LLM_PROVIDER=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash
GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
LLM_STRUCTURED_MODE=json_schema        # json_schema | json_object
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2                      # extra attempts on the same model
LLM_MAX_CALLS_PER_REQUEST=8            # logical prompt executions (the legitimate maximum is 7)
LLM_TEMPERATURE=0.2
LLM_FAKE_CHAOS=none                    # none | primary-timeout-once | primary-down | all-down

EMBEDDER=hash                          # hash (the only one in v1; minilm arrives with the optional milestone M9)
RAG_TOP_K=3
RAG_MIN_SCORE=                         # empty: uses the embedder's calibrated default
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

SQL_MAX_CORRECTIONS=3
SQL_MAX_ROWS=200
SQL_ROWS_TO_LLM=50
SQL_TIMEOUT_MS=5000                    # SQL execution deadline; past it, the child process gets SIGKILL

GUARDRAIL_MODE=                        # rules | rules+model | off. Empty: rules with fake, rules+model with openrouter

APP_DB_PATH=data/app.db
SALES_DB_PATH=data/sales.db
HOST=127.0.0.1
PORT=3000
ASK_TIMEOUT_MS=60000
LOG_LEVEL=info
